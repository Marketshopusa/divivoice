# Virtual Environment
backend/venv/
venv/
ENV/
env/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# User uploads & heavy model outputs (audio/video files)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# Local database
backend/divivoice.db
*.sqlite3
*.db

# Vercel & Node
.vercel/
node_modules/
dist/

# Flutter build artifacts (preserve build/web for production serving)
frontend_flutter/.dart_tool/
frontend_flutter/.flutter-plugins
frontend_flutter/.flutter-plugins-dependencies
frontend_flutter/.packages
frontend_flutter/build/app/
frontend_flutter/build/flutter_assets/
frontend_flutter/build/ios/
frontend_flutter/build/linux/
frontend_flutter/build/macos/
frontend_flutter/build/windows/

# System and logs
*.log
.DS_Store
Thumbs.db
